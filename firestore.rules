rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && request.auth.token.prospecAdmin == true; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }

    // Public catalogue and announcement. Owner writes are performed by the
    // server after validating the HttpOnly Prospec owner session.
    match /prospecPublic/{documentId} {
      allow read: if documentId == "storefront";
      allow write: if isOwner();
    }

    // Customers use persistent anonymous Firebase Auth identities. They can
    // read and update only their own profile.
    match /prospecCustomers/{uid} {
      allow read: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(["uid", "name", "email", "phone", "createdAt", "updatedAt"])
        && request.resource.data.uid == uid;
      allow delete: if false;
    }

    // Each enquiry is permanently tied to the Firebase Auth UID that created it.
    match /prospecEnquiries/{enquiryId} {
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "customerId", "customerName", "email", "whatsapp", "notificationOptIn",
          "serviceId", "serviceName", "serviceItems", "quoteRequired", "price",
          "dueDate", "brief", "status", "createdAt", "statusUpdatedAt",
          "messages", "paymentStatus", "originalPrice", "discountAmount", "discountCode", "quotedPrice", "paidAmount",
          "paidAt", "receiptNo", "completedAt"
        ])
        && request.resource.data.status == "New request"
        && request.resource.data.messages is list
        && request.resource.data.messages.size() == 0
        && request.resource.data.price is number
        && request.resource.data.price >= 0;
      allow read: if isOwner() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow update: if isOwner() || (
        signedIn()
        && resource.data.customerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["messages", "updatedAt"])
        && request.resource.data.updatedAt is string
        && request.resource.data.messages is list
        && request.resource.data.messages.size() <= 100
        && request.resource.data.messages.hasAll(resource.data.get("messages", []))
        && request.resource.data.messages.size() == resource.data.get("messages", []).size() + 1
        && request.resource.data.messages[request.resource.data.messages.size() - 1].from == "customer"
        && request.resource.data.messages[request.resource.data.messages.size() - 1].text is string
        && request.resource.data.messages[request.resource.data.messages.size() - 1].text.size() <= 2000
      );
      allow delete: if isOwner();

      match /messages/{messageId} {
        allow read: if isOwner() || (
          signedIn()
          && get(/databases/$(database)/documents/prospecEnquiries/$(enquiryId)).data.customerId == request.auth.uid
        );
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderRole == "customer"
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && get(/databases/$(database)/documents/prospecEnquiries/$(enquiryId)).data.customerId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /prospecOwnerPrivate/{documentId} {
      allow read, write: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
